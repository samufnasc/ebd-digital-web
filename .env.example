# Supabase - URL e chave anonima do projeto
# Copie este arquivo como .env e preencha com seus valores reais
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"
VITE_SUPABASE_KEY="sua-chave-anonima-aqui"

# Nota: Na Vercel, a variavel pode estar como VITE_SUPABASE_ANON_KEY.
# O codigo aceita ambos os nomes (VITE_SUPABASE_KEY || VITE_SUPABASE_ANON_KEY).
